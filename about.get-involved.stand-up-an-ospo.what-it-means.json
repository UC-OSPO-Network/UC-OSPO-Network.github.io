{"version":3,"kind":"Article","sha256":"a98bc94c064e43922643271b7e5a61d08a5b792e8d6075364f95de755b389e55","slug":"about.get-involved.stand-up-an-ospo.what-it-means","location":"/about/get-involved/stand-up-an-ospo/what-it-means.md","dependencies":[],"frontmatter":{"title":"What it means to declare yourself an OSPO","github":"https://github.com/UC-OSPO-Network/ucospo.net","copyright":"2024","numbering":{"title":{"offset":3}},"source_url":"https://github.com/UC-OSPO-Network/ucospo.net/blob/main/about/get-involved/stand-up-an-ospo/what-it-means.md","edit_url":"https://github.com/UC-OSPO-Network/ucospo.net/edit/main/about/get-involved/stand-up-an-ospo/what-it-means.md","exports":[{"format":"md","filename":"what-it-means.md","url":"/build/what-it-means-0094c112f79c6e04366cd94598cced51.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"An OSPO can take many shapes, and the Network is deliberately a big tent. What matters is that there’s a recognized home for open source work at your institution and a person accountable for it.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"qYQWXaYIDe"}],"key":"efLyP2aNny"},{"type":"heading","depth":2,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"What an OSPO looks like in UC","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"RoOV6wJTJe"}],"identifier":"what-an-ospo-looks-like-in-uc","label":"What an OSPO looks like in UC","html_id":"what-an-ospo-looks-like-in-uc","implicit":true,"key":"aFFvOZMhDI"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"The Network doesn’t prescribe a single model. An OSPO might be one coordinator, a library-hosted effort, a faculty-led group, or a fully staffed office—all of these count. Two principles shape how Member Organizations work together:","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"GpSNWM3zsS"}],"key":"zON4bdeApY"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":11,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"High autonomy:","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"UXdRCnZcyV"}],"key":"Odp61qJN5A"},{"type":"text","value":" you decide how your OSPO is structured, staffed, and run. The Network coordinates and shares; it doesn’t dictate your organization’s internal operations.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"uEcEvX4AcQ"}],"key":"xRNGWymAF2"}],"key":"eUDebxAxQw"},{"type":"listItem","spread":true,"position":{"start":{"line":12,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Peers, not hierarchy:","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"W6Jd6LImHj"}],"key":"VInCjuh1tI"},{"type":"text","value":" within the Network, every Member Organization participates as a peer, regardless of how large their institutions are.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"n1498hvn7P"}],"key":"FQGVI5ZeYi"}],"key":"ZVvwfCaIlL"}],"key":"flRrMdBJRD"},{"type":"heading","depth":2,"position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"What declaring yourself an OSPO commits you to","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"xVRZ38R1ar"}],"identifier":"what-declaring-yourself-an-ospo-commits-you-to","label":"What declaring yourself an OSPO commits you to","html_id":"what-declaring-yourself-an-ospo-commits-you-to","implicit":true,"key":"vj1uvaGYGt"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"Joining the Network as a Member Organization comes with a few concrete commitments:","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"mJtCnoPLsA"}],"key":"K3SRJwxm7b"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":18,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"An executive Sponsor:","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"W8oT0zkMvM"}],"key":"adSa6djhtW"}],"key":"hHtzEFWjTX"}],"key":"gJcQJKhUGo"},{"type":"listItem","spread":true,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Joining the Network requires the written approval of a Sponsor.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"bkVodQX775"}],"key":"dhAQLM44Th"}],"key":"Ju47aCslHe"},{"type":"listItem","spread":true,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Sponsors champion the vitality, viability and long-term sustainability of the Network at their Member Organization and across the UC system. Ideally, they also identify opportunities for increased coherence within the Member Organization, building connections with entities whose mission overlaps with that of the UC OSPO Network.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"rgztBI2B97"}],"key":"CJLu4TsRa2"}],"key":"KfZHAxHlqN"},{"type":"listItem","spread":true,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The acceptance of a Member Organization into the Network is ultimately a bilateral agreement between the Stewardship Group and the Sponsor. Member Organizations can also withdraw from the Network—this is a unilateral action that rests with the Sponsor.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"AYj9HIiWns"}],"key":"JNDEhuX8z7"}],"key":"lMSch3lOU3"},{"type":"listItem","spread":true,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Sponsors should be leaders with division-wide executive authority and final oversight of institutional budgets and strategic operations. For university campuses, they should either be, or report directly to, the Chancellor, Executive Vice Chancellor, Provost, or a Vice Chancellor. Exceptions will be considered on a case-by-case basis.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"u7brD3TQkv"}],"key":"Snehvc5Ydr"}],"key":"P2Ew2WIvqA"},{"type":"listItem","spread":true,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Participation in at least one Working Group:","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"yrARjXlNex"}],"key":"ZKyx2lRT6e"},{"type":"text","value":" every Member Organization commits to taking part in at least one of the Network’s ","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"ytjb3Xr7os"},{"type":"link","url":"/about/get-involved/working-groups","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Working Groups","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"GUWglF9nkh"}],"urlSource":"../working-groups.md","dataUrl":"/about.get-involved.working-groups.json","internal":true,"protocol":"file","key":"sV4sG8liM4"},{"type":"text","value":".","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"ZgETJlB4Vr"}],"key":"oXRViGAl7l"}],"key":"ZwWo0SpDa3"},{"type":"listItem","spread":true,"position":{"start":{"line":24,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"A delegate to the Stewardship Group:","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"sFvAgeSSU5"}],"key":"Hy0pdOPOiR"},{"type":"text","value":" each Member Organization names one delegate to take part in the Network’s stewardship and decision-making (a back-up delegate is allowed).","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"kmCx0oE5UH"}],"key":"oMJWu4fmQ8"}],"key":"cPTBz2irY0"}],"key":"rd7If9GsPE"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"How you meet these is up to you—the autonomy principle applies here too.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"bRiONRPZs9"}],"key":"s5Egi4Iyih"},{"type":"comment","value":"\nTODO: \"Step zero\" section—uncomment once the \"Case for OSPO\" docs are published to the site.\n\n## Step zero: making the case at your institution\n\nBefore any of that, you'll usually need to bring people along—a Sponsor to sign off, and colleagues to make the OSPO real. That starts with being able to explain, briefly, why an OSPO is worth it for your institution. [link the Case for OSPO docs here]\n","key":"SAMXoEuT8K"},{"type":"heading","depth":2,"position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Who to talk to first","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"voQbLhCGMo"}],"identifier":"who-to-talk-to-first","label":"Who to talk to first","html_id":"who-to-talk-to-first","implicit":true,"key":"OP26YDfVze"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Beyond your Sponsor, the earliest conversations are usually with the people whose work already touches open source: research computing, the library, and any faculty or staff already championing it. ","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"zUV2qewMD0"},{"type":"link","url":"/about/get-involved/stand-up-an-ospo/local-stakeholders","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Connecting with local stakeholders","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"Bvx6vvNZAk"}],"urlSource":"./local-stakeholders.md","dataUrl":"/about.get-involved.stand-up-an-ospo.local-stakeholders.json","internal":true,"protocol":"file","key":"GV4JitQ6eR"},{"type":"text","value":" goes into each of these.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"pXSjfAfbaJ"}],"key":"VdUblzcAeu"},{"type":"div","children":[{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"link","url":"./","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"← Stand up an OSPO","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"Qjz2hCbyCe"}],"urlSource":"./","key":"ZqwM2kdJ