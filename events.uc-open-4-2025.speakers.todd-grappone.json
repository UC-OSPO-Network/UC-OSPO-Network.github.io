{"version":3,"kind":"Article","sha256":"6778156dd105e5b53bb773b65826e72e243bf4b04fee055d4ece295b489dde07","slug":"events.uc-open-4-2025.speakers.todd-grappone","location":"/events/uc-open-4-2025/speakers/todd-grappone.md","dependencies":[],"frontmatter":{"title":"Todd Grappone","github":"https://github.com/UC-OSPO-Network/ucospo.net","copyright":"2024","numbering":{"title":{"offset":1}},"source_url":"https://github.com/UC-OSPO-Network/ucospo.net/blob/main/events/uc-open-4-2025/speakers/todd-grappone.md","edit_url":"https://github.com/UC-OSPO-Network/ucospo.net/edit/main/events/uc-open-4-2025/speakers/todd-grappone.md","thumbnail":"/build/todd-grappone-8a913675178085dd391a3c59392aa10d.jpeg","exports":[{"format":"md","filename":"todd-grappone.md","url":"/build/todd-grappone-cd45732aedda0e68e6dcded876b366cb.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"image","url":"/build/todd-grappone-8a913675178085dd391a3c59392aa10d.jpeg","alt":"Speaker photo","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"pwiVjpGnSa","urlSource":"headshots/todd-grappone.jpeg"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Todd Grappone is a librarian and information technology expert with over twenty years of experience in academic institutions.\nHe is the Associate University Librarian for Digital Initiatives & Information Technology, Research and Development at UCLA.\nHe is responsible for ensuring that the library maintains a reliable, scalable, and sustainable environment.\nHe oversees five enterprise-wide departments to promote and coordinate public services and develop connections with research faculty to meet their evolving needs.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"uBBMUPKuWe"}],"key":"uHX6dhzAfZ"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Todd has worked to develop and oversee many large-scale initiatives in digital preservation, global collections development, and post-custodial community archives.\nHe is the driving force behind some of the most impactful digital library programs in the world like the Modern Endangered Archives Program, a celebrated and critically important program that works to meet the urgent need of preserving at risk cultural heritage across the globe.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"y6X0b4pkSu"}],"key":"XUTMA4il8W"},{"type":"heading","depth":2,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Session","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"NjV8KeYKxs"}],"identifier":"session","label":"Session","html_id":"session","implicit":true,"key":"SLiQhldcIh"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"link","url":"/events/uc-open-4-2025/sessions/what-is-open","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Open S#####? Understanding What is Meant by ‘Open’","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"a0qrAejx5B"}],"urlSource":"../sessions/what-is-open.md","dataUrl":"/events.uc-open-4-2025.sessions.what-is-open.json","internal":true,"protocol":"file","key":"Apx6UytiGP"}],"key":"ScmAkR2qzK"}],"key":"JhhmePqQK8"}],"key":"Iwm7yBAkSW"},"references":{"cite":{"order":[],"data":{}}},"footer":{},"domain":"http://localhost:3000"}