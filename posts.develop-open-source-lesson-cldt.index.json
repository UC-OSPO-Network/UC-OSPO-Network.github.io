{"version":3,"kind":"Article","sha256":"990f922fc659d11522f90d46e1e1183118c618a8db5b208d75728cd059dcf5ab","slug":"posts.develop-open-source-lesson-cldt.index","location":"/posts/develop-open-source-lesson-cldt/index.md","dependencies":[],"frontmatter":{"title":"Develop an Open Source Lesson with the UC OSPO Network","description":"The UC OSPO Network is running four Carpentries Collaborative Lesson Development Training cohorts this summer and fall. We're looking for people to join an already-scoped lesson team or propose a new lesson.","tags":["carpentries","ospo","education","lesson","open-source","ucospo"],"authors":[{"id":"Tim Dennis","name":"Tim Dennis"}],"date":"2026-06-15","github":"https://github.com/UC-OSPO-Network/ucospo.net","copyright":"2024","numbering":{"title":{"offset":1}},"source_url":"https://github.com/UC-OSPO-Network/ucospo.net/blob/main/posts/develop-open-source-lesson-cldt/index.md","edit_url":"https://github.com/UC-OSPO-Network/ucospo.net/edit/main/posts/develop-open-source-lesson-cldt/index.md","exports":[{"format":"md","filename":"index.md","url":"/build/index-92ec0d62894c833cd13c785009914850.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Four ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"qgxZG3BdSG"},{"type":"link","url":"https://carpentries.github.io/lesson-development-training/","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Carpentries Collaborative Lesson Development Training","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"R3gawavWPR"}],"urlSource":"https://carpentries.github.io/lesson-development-training/","key":"mtLCDHVoKF"},{"type":"text","value":" (CLDT) cohorts are running through the UC OSPO Network this summer and fall. The software licensing cohort is confirmed and already full.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"LlhSLOQoJw"}],"key":"K6NR0vB4Jg"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Three cohorts are still forming. You can join an already-scoped team or propose a new lesson and build your own.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"NVWCidejfW"}],"key":"S64V7GWVpK"},{"type":"heading","depth":2,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"What is CLDT?","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"sXLydoOpiq"}],"identifier":"what-is-cldt","label":"What is CLDT?","html_id":"what-is-cldt","implicit":true,"key":"RZJdIYjCbu"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Teams of 2-5 people spend the training applying backward design to a lesson: who they’re teaching, what learners need to be able to do, what exercises get them there, and how to structure it in the ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"L17wFBQ0G1"},{"type":"link","url":"https://carpentries.github.io/workbench/","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Carpentries Workbench","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"NR2fBsupAk"}],"urlSource":"https://carpentries.github.io/workbench/","key":"p70LC8DZqj"},{"type":"text","value":".","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"nn2NYMLW5x"}],"key":"Szw7ypVm3v"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"By the end, you’ll have a complete outline and a working draft of several sections.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"HwC3EdC3UN"}],"key":"jAhi9VeC37"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Certification requires one more step: teaching part of the lesson and debriefing with a trainer on what you learned and what to improve.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"FSLHC8FNsd"}],"key":"Bg6Dpo8AzL"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Before joining, at least one team member must have completed ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"c0QEcd13do"},{"type":"link","url":"https://carpentries.org/instructor-training/","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Carpentries Instructor Training","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"H4468TcAId"}],"urlSource":"https://carpentries.org/instructor-training/","key":"P5qkAYqcSC"},{"type":"text","value":" or ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"w23gPU7axp"},{"type":"link","url":"https://carpentries.org/learner-centered-teaching/","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Learner-Centered Teaching","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"b0kiwy8mWU"}],"urlSource":"https://carpentries.org/learner-centered-teaching/","key":"CV6YS2ISeH"},{"type":"text","value":".","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"QP3PRDpeUL"}],"key":"xrPb1svzbw"},{"type":"heading","depth":2,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Option 1: join the “Librarians as Open Source Stewards” cohort","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"qGkDtdODJe"}],"identifier":"option-1-join-the-librarians-as-open-source-stewards-cohort","label":"Option 1: join the “Librarians as Open Source Stewards” cohort","html_id":"option-1-join-the-librarians-as-open-source-stewards-cohort","implicit":true,"key":"FZKQhOuFlX"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"This lesson is scoped and ready. It builds on skills librarians already have - curation, preservation, metadata, community stewardship - and treats them as open source contributions.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"M81CPUbQMB"}],"key":"wETBYyng0W"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"We need 2-4 people to help develop and pilot it.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"FdLaaLEuas"}],"key":"MifIi9Mh6m"},{"type":"heading","depth":2,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Option 2: propose a new lesson","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"DXwCULjds8"}],"identifier":"option-2-propose-a-new-lesson","label":"Option 2: propose a new lesson","html_id":"option-2-propose-a-new-lesson","implicit":true,"key":"N1EleHWrwT"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Two slots are open for new lesson ideas. If you have a topic that fits the open source and OSPO ecosystem - security practices for academic open source, open source in non-CS research, governance models, contributing as a non-coder, reproducibility and open data - pitch it.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"hbiQkUG1D4"}],"key":"x6GgL6U4wo"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"To propose, you need a topic and a rough sense of who you’re teaching. That’s it. If the idea is a good fit, we’ll work with you to recruit a development team before the cohort starts.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"QcHKD3qt5A"}],"key":"m8m3ZTXa3G"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Finished lessons live in the UC OSPO curriculum catalog and get taught through UC OSPO and partner programs. From there, lessons can move into the broader Carpentries lesson programs or go through ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"C5OjUAEawZ"},{"type":"link","url":"https://carpentries-lab.org","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Carpentries Lab","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"yqjbV6cyui"}],"urlSource":"https://carpentries-lab.org","key":"J6xQKM4WyO"},{"type":"text","value":", an open peer-review process focused on lesson design, content quality, and accessibility.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"DSxC5ZLWVh"}],"key":"TtusWxNyLx"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"The Lab is currently reviewing by invitation, so early contact matters.","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"NRldlhMMlx"}],"key":"mu24LQBPfb"},{"type":"heading","depth":2,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"What authors get","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"vBSkMJmjQ8"}],"identifier":"what-authors-get","label":"What authors get","html_id":"what-authors-get","implicit":true,"key":"UO3bvPvfYr"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Lab acceptance qualifies you to submit to ","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"lFmWQlChQ7"},{"type":"link","url":"https://jose.theoj.org","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"JOSE","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"WlKerxsS5y"}],"urlSource":"https://jose.theoj.org","key":"y2gN2BtnLm"},{"type":"text","value":" (Journal of Open Source Education). The JOSE review is separate - it evaluates an accompanying paper, not the lesson itself.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"Vp2TbH9axb"}],"key":"rXwXPxCM5Z"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Authors who complete both get a Crossref DOI. The publication is peer-reviewed, indexed by Google Scholar, and follows you if you move institutions. The UC OSPO Network will provide editorial support for teams pursuing JOSE, including mentorship through submission and review.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"y8pdSYkaN7"}],"key":"zKxdn7w7FY"},{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Lessons staying institutional can still get a Zenodo DOI. We maintain a Zenodo community connected to our GitHub organization, and DOI minting is part of the publication process before a lesson goes public.","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"SflCsoPJaX"}],"key":"VRxbj70V2U"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"You don’t need broad adoption to get credit for your work.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"I1MblCCXMx"}],"key":"yLPQ87L3hR"},{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"We provide Workbench-compatible repository templates and setup support so teams arrive at CLDT ready to build. Most lessons stall at the pilot stage. We actively create teaching opportunities through UC Carpentries and the ","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"JHzaIaW5eH"},{"type":"link","url":"https://curioss.org/","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"CURIOSS network","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"sM0orbmQy8"}],"urlSource":"https://curioss.org/","key":"pim1fdBUee"},{"type":"text","value":" so lessons get tested and refined.","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"gqyRMWa9r4"}],"key":"h1A03okkh4"},{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"If contributors move institutions, lessons hosted in the ","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"AczbGxTnZA"},{"type":"link","url":"https://github.com/UC-OSPO-Network","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"UC OSPO GitHub organization","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"dDuFGRcoFX"}],"urlSource":"https://github.com/UC-OSPO-Network","error":true,"key":"PBvSzPLWP2"},{"type":"text","value":" can continue to be maintained through network oversight.","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key