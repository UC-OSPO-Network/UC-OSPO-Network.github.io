{"version":3,"kind":"Article","sha256":"ad9d13996aaa372e3fa3db32e38c68d048f849c8d39810e44c3632459dbfcecb","slug":"about.get-involved.stand-up-an-ospo.local-stakeholders","location":"/about/get-involved/stand-up-an-ospo/local-stakeholders.md","dependencies":[],"frontmatter":{"title":"Connecting with local stakeholders","github":"https://github.com/UC-OSPO-Network/ucospo.net","copyright":"2024","numbering":{"title":{"offset":3}},"source_url":"https://github.com/UC-OSPO-Network/ucospo.net/blob/main/about/get-involved/stand-up-an-ospo/local-stakeholders.md","edit_url":"https://github.com/UC-OSPO-Network/ucospo.net/edit/main/about/get-involved/stand-up-an-ospo/local-stakeholders.md","exports":[{"format":"md","filename":"local-stakeholders.md","url":"/build/local-stakeholders-156429b316adc279e59edc27e066bf94.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"An OSPO works largely by connecting efforts that already exist on your campus rather than building everything itself. A handful of partners are worth finding early—they often share your goals and can offer space, reach, expertise, or legitimacy.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"RwbbOLCXcq"}],"key":"cmInHzieG4"},{"type":"heading","depth":2,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Who to look for","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"aIbhxM8ILD"}],"identifier":"who-to-look-for","label":"Who to look for","html_id":"who-to-look-for","implicit":true,"key":"xBi6V5JsNl"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":9,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"The library:","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"QwnamXQh5M"}],"key":"avBWsxW3BO"},{"type":"text","value":" frequently the most natural home or co-sponsor for an OSPO. Scholarly communication, data services, and open access overlap heavily with open source goals, and libraries tend to offer welcoming, neutral space. Across the Network, campus meetups are very often library-hosted, and some OSPOs are based in the library outright.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"tc73kVHRbi"}],"key":"z0i30BSjSK"}],"key":"nWUpk0cbsZ"},{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Research computing and data-science groups:","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"MDpbWSFJ9g"}],"key":"IDtm1FdpcU"},{"type":"text","value":" the people who support researchers who write code—campus research computing, data-science institutes, and centers focused on research software. They see open source needs every day and make strong allies (in the Network, groups like DataLab at Davis, BIDS at Berkeley, and CROSS at Santa Cruz play this role).","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"jcNOJoaDEL"}],"key":"uT8kWcjxqA"}],"key":"XM3KnfdoIC"},{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Technology transfer and licensing:","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"n3rMN7VJNg"}],"key":"SuUiz0BWaf"},{"type":"text","value":" your tech-transfer or licensing office handles the IP, licensing, and compliance questions that surface the moment researchers release software. Bringing them in early helps your researchers and keeps your guidance accurate.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"bCenMtPBUB"}],"key":"ez5YkkFjHS"}],"key":"TWvCwC5KK3"},{"type":"listItem","spread":true,"position":{"start":{"line":12,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Faculty champions and academic governance:","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"pjIDbEEjq5"}],"key":"oZAd93u41D"},{"type":"text","value":" faculty already doing or advocating for open source give you reach and credibility, and connections into academic governance help with longer-term institutional support.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"tTsHfjskPV"}],"key":"bklYGMTkgI"}],"key":"HHOhKVMkb8"}],"key":"TiMZ1OGRvm"},{"type":"heading","depth":2,"position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"How to approach them","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"W8vdgXvHyT"}],"identifier":"how-to-approach-them","label":"How to approach them","html_id":"how-to-approach-them","implicit":true,"key":"VBLazrGACT"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"Start where the energy already is—an office or person already leaning toward open source. You’re connecting existing work, not asking for a budget on day one, so a warm, specific introduction tends to land better than a broad campaign. One good partnership often opens the next.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"tKT8KIJKhH"}],"key":"uKXS8lwaRO"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Reach out to Laura (community manager) for help here too: the Network can tell you who plays these roles at other campuses, share what kinds of partnerships have worked, and sometimes make an introduction directly.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"lZE5CBaFtC"}],"key":"RWxJtuePj4"},{"type":"div","children":[{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"link","url":"/about/get-involved/stand-up-an-ospo/what-it-means","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"← What it means to declare yourself an OSPO","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"EBpQhrhpvD"}],"urlSource":"./what-it-means.md","dataUrl":"/about.get-involved.stand-up-an-ospo.what-it-means.json","internal":true,"protocol":"file","key":"YnecDU9yxe"}],"key":"hqbX0LNiTi"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"link","url":"/about/get-involved/stand-up-an-ospo/web-presence","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Web presence →","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"gERQgXcVir"}],"urlSource":"./web-presence.md","dataUrl":"/about.get-involved.stand-up-an-ospo.web-presence.json","internal":true,"protocol":"file","key":"zLFP9CsNsV"}],"key":"mzTzMXL54W"}],"class":"page-nav","key":"JqXbCMASpA"}],"key":"oUVWz3ESCt"}],"key":"nJdfrpCx4i"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"What it means to declare yourself an OSPO","url":"/about/get-involved/stand-up-an-ospo/what-it-means","group":"Get Involved"},"next":{"title":"Web presence","url":"/about/get-involved/stand-up-an-ospo/web-presence","group":"Get Involved"}}},"domain":"http://localhost:3000"}