s, or something else, and the end of the meeting is reserved for network updates and Q&A.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"cdjNH92sUH"}],"key":"JoGwHGq4xg"}],"class":"ucsb-clearfix","key":"jLeRl3S38C"},{"type":"div","children":[{"type":"paragraph","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"link","class":"btn-ucsb-secondary","url":"/events#all-campus-virtual-meetups-monthly","children":[{"type":"text","value":"Register for the meetup","key":"l6jrXuZpjI"}],"urlSource":"/events#all-campus-virtual-meetups-monthly","key":"tDLYHWhRXw"}],"key":"KRJe3skoKE"}],"class":"btn-center-wrapper","key":"aPSV3PfgBV"},{"type":"heading","depth":3,"position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"text","value":"Sustainability Playbook","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"key":"UZL7jZnByD"}],"identifier":"sustainability-playbook","label":"Sustainability Playbook","html_id":"sustainability-playbook","implicit":true,"key":"IGPxtlOQvm"},{"type":"div","children":[{"type":"image","url":"/build/umbrella_logo-ee634f6aecb862fcd334c18dccb2b66d.svg","alt":"UC OSPO Logo, which looks like an abstract person, modified so it's holding an umbrella","align":"center","class":"ucsb-float-right","key":"acx7UYf6Lb","urlSource":"../static/images/ucsb/umbrella_logo.svg"},{"type":"paragraph","position":{"start":{"line":100,"column":1},"end":{"line":106,"column":1}},"children":[{"type":"text","value":"Since our recent survey showed that many open source contributors are struggling\nwith project sustainability, we are creating a website with resources on the topic.\nWe are calling it the “Sustainability Playbook”. It will be tailored to UC throughout,\npointing readers to the relevant staff offices that can help, with tips and tricks for\nnavigating UC’s administrative channels. The playbook will be rich with interviews\nfrom UC devel