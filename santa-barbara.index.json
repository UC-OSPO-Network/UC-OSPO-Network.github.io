ber 1 2026, the UCSB Open Source Lounge will meet every week!\nThe UCSB Open Source Lounge is a co-working space where UCSB students, faculty,\nand staff of all experience levels can come work on their open source goals in\na supportive environment. Join us to meet others interested in open source and\nbe a part of a larger open source community at UCSB.","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"JOSYjrjza1"}],"key":"gGOJlLtDCG"},{"type":"div","children":[{"type":"paragraph","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"link","class":"btn-ucsb-secondary","url":"/santa-barbara/ucsb-projects/lounge","children":[{"type":"text","value":"Visit the lounge webpage","key":"ADFdmD5rPb"}],"urlSource":"/santa-barbara/ucsb-projects/lounge","dataUrl":"/santa-barbara.ucsb-projects.lounge.json","internal":true,"protocol":"file","key":"uUWPLx29on"}],"key":"agDhbjxULp"}],"class":"btn-center-wrapper","key":"ig18XajmR2"},{"type":"heading","depth":3,"position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"All-campus meetup","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"e7lJ0POP4g"}],"identifier":"all-campus-meetup","label":"All-campus meetup","html_id":"all-campus-meetup","implicit":true,"key":"DsmRdSH1t3"},{"type":"div","children":[{"type":"image","url":"/build/chris_montgomery_uns-0528a6c41cde97f91550f9285fce088e.jpg","alt":"A cozy scene of a Zoom meeting on a laptop, with a mug next to the laptop","align":"center","class":"ucsb-float-left","key":"UZLWlMJVYy","urlSource":"../static/images/ucsb/chris_montgomery_unsplash.jpg"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"A monthly gathering for the UC open source community. Each meetup is hosted by a different campus in the network. The main content may consist of demos, guest speakers, or something else, and the end of the meeting is reserved for network updates and Q&A.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"qsrPBLGFIz"}],"key":"J9L9y71LtI"}],"class":"ucsb-clearfix","key":"pwXd8FjxP4"},{"type":"div","children":[{"type":"paragraph","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"link","class":"btn-ucsb-secondary","url":"/events#all-campus-virtual-meetups-monthly","children":[{"type":"text","value":"Register for the meetup","key":"WbidaD32Hv"}],"urlSource":"/events#all-campus-virtual-meetups-monthly","key":"lpXabugUGO"}],"key":"AlSevw8j3F"}],"class":"btn-center-wrapper","key":"PND7LbJz7c"},{"type":"heading","depth":3,"position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"text","value":"Sustainability Playbook","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"key":"tdCxKHL14C"}],"identifier":"sustainability-playbook","label":"Sustainability Playbook","html_id":"sustainability-playbook","implicit":true,"key":"LDBkUGvw4v"},{"type":"div","children":[{"type":"image","url":"/build/susPB_logo-5275ad32d621b802354868d78cd6317b.svg","alt":"UC OSPO Logo with the words 'sustainability playbook' in stylized text","align":"center","class":"ucsb-float-right","key":"vm9LntXFRW","urlSource":"../static/images/ucsb/susPB_logo.svg"},{"type":"paragraph","position":{"start":{"line":100,"column":1},"end":{"line":106,"column":1}},"children":[{"type":"text","value":"Since our recent survey showed that many open source contributors are struggling\nwith project sustainability, we are creating a website with resources on the topic.\nWe are calling it the “Sustainability Playbook”. It will be tailored to UC throughout,\npointing readers to the relevant staff offices that can help, with tips and tricks for\nnavigating UC’s administrative channels. The playbook will be rich with interviews\nfrom UC developers and project stewards discussing how they have so far succeeded in\nsustaining an open source project.","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"cw8Op7zEaw"}],"key":"MtQYrx4QO8"}],"class":"ucsb-clearfix","key":"vUEj5l1ToD"}],"key":"FZPqgqGplw"}],"class":"ucsb-panel-light","key":"HiOtgWLThN"},{"type":"comment","value":" PAST PROJECTS ","key":"ZSmNr7k41u"},{"type":"div","children":[{"type":"card","children":[{"type":"cardTitle","children":[{"type":"text","value":"Past projects","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"g9qCGOLQYI"}],"key":"qhz63GNU5H"},{"type":"heading","depth":3,"position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"text","value":"UC Open Source Survey","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"key":"Qjb5l2EbyM"}],"identifier":"uc-open-source-survey","label":"UC Open Source Survey","html_id":"uc-open-source-survey","implicit":true,"key":"nKNwebawUI"},{"type":"div","children":[{"type":"div","children":[{"type":"image","url":"/build/infographic_small_cr-bbbb0c230ada3934b8ffed09eb77f9ef.png","alt":"Thumbnail preview of an infographic","align":"center","class":"ucsb-thumbnail-img","key":"JcG0KzXHHY","urlSource":"../static/images/ucsb/infographic_small_crop.png"}],"class":"ucsb-thumbnail-wrapper","key":"AabLtDMuA0"},{"type":"paragraph","position":{"start":{"line":135,"column":1},"end":{"line":137,"column":1}},"children":[{"type":"text","value":"In 2025, our team spearheaded a survey of nearly 300 open source contributors\nas part of the UC OSPO Network’s discovery activities. You can\n","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"KylcJ8Kz8D"},{"type":"link","url":"https://ucospo.net/oss-resources/survey/","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"children":[{"type":"text","value":"read more about the UC Open Source Contributor Survey here","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"k6nrkihSws"}],"urlSource":"https://ucospo.net/oss-resources/survey/","key":"cBFT9rOroV"},{"type":"text","value":".","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"W4QznwY91o"}],"key":"bpDbjRVJPN"}],"class":"ucsb-clearfix","key":"sqXQeDUnAu"}],"key":"pAZq4YdFs4"}],"class":"ucsb-panel-dark","key":"rl1XBTE1XD"},{"type":"heading","depth":2,"position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"children":[{"type":"text","value":"What’s the status of the UCSB OSPO?","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"key":"IKBK4NNUCO"}],"identifier":"whats-the-status-of-the-ucsb-ospo","label":"What’s the status of the UCSB OSPO?","html_id":"whats-the-status-of-the-ucsb-ospo","implicit":true,"key":"V9CqBT0pHo"},{"type":"paragraph","position":{"start":{"line":146,"column":1},"end":{"line":151,"column":1}},"children":[{"type":"text","value":"At present, UCSB does not have a dedicated Open Source Programs Office. Rather,\nwe have a cross-functional team of UCSB staff with expertise in open source\nwho are developing the strategies, know-how, and connections needed to create\nan OSPO. Building on the work of the Open Source Programs Team, the OSPO will\ndraw on resources developed by the UC OSPO Network, and its priorities will be\nshaped by both UC leadership and the UCSB open source community.","position":{"start":{"line":146,"column":1},"end":{"line":146,"column":1}},"key":"NjulCB9FVK"}],"key":"tFmTlvOR9a"},{"type":"heading","depth":2,"position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"children":[{"type":"text","value":"Get connected","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"key":"ybFpzoY5O0"}],"identifier":"get-connected","label":"Get connected","html_id":"get-connected","implicit":true,"key":"j5j1s4zaY6"},{"type":"comment","value":" ::::{div}\n:class: ospo-img\n\n