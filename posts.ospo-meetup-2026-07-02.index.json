{"version":3,"kind":"Article","sha256":"f27a1a7000f9bd0421621e65c1f917ce95f06a8b784e662cad504f141fe1be60","slug":"posts.ospo-meetup-2026-07-02.index","location":"/posts/ospo-meetup-2026-07-02/index.md","dependencies":[],"frontmatter":{"title":"A New Chapter for UC Open Source: Highlights from the First All-Campus Virtual Meetup","description":"Recap for the July 02 UC OSPO All-Campus Virtual Meetup","authors":[{"id":"Chenrong Zheng","name":"Chenrong Zheng"}],"date":"2026-07-17","github":"https://github.com/UC-OSPO-Network/ucospo.net","copyright":"2024","numbering":{"title":{"offset":1}},"source_url":"https://github.com/UC-OSPO-Network/ucospo.net/blob/main/posts/ospo-meetup-2026-07-02/index.md","edit_url":"https://github.com/UC-OSPO-Network/ucospo.net/edit/main/posts/ospo-meetup-2026-07-02/index.md","thumbnail":"/build/nsf-banner-248e524ddad3ab2a2966e5ec36fb19bb.png","exports":[{"format":"md","filename":"index.md","url":"/build/index-02fe9ea5b08a1c95e9411d794ff6dec0.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"On July 2, 2026, the UC open source community reached an exciting new milestone. Our monthly campus-specific gatherings officially transitioned into one unified all-campus virtual meetup. This first meetup in the series was hosted by the ","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"QKuWWOA0P3"},{"type":"link","url":"https://library.ucdavis.edu/ospo/","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"UC Davis OSPO","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"qW3vUQwRWr"}],"urlSource":"https://library.ucdavis.edu/ospo/","key":"gyJigGklvs"},{"type":"text","value":" team, setting a powerful precedent for how our network can collaborate, share resources, and grow together. Under this new format, the first half of the meeting consists of workshops or guest speakers moderated by one UC campus. The second half is dedicated to community updates and chats. The OSPO Monthly Meetup also has expanded its network by inviting participants from outside the UC system, such as a program manager from ArchivesSpace, proving that our network is becoming a hub for the broader open source community.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"GtStAW4HE1"}],"key":"OnvS62GLBP"},{"type":"heading","depth":2,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Demystifying the NSF PESOSE Grant","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"h6O2O4C441"}],"identifier":"demystifying-the-nsf-pesose-grant","label":"Demystifying the NSF PESOSE Grant","html_id":"demystifying-the-nsf-pesose-grant","implicit":true,"key":"A9WgQznpkh"},{"type":"image","url":"/build/nsf-banner-248e524ddad3ab2a2966e5ec36fb19bb.png","alt":"The logo of the US National Science Foundation in the middle with a person in a lab outfit on the right edge of the banner","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"AOqvEeDaLu","urlSource":"nsf-banner.png"},{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"The spotlight of the July meetup was an in-depth panel discussion on the National Science Foundation’s ","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"fdXh3fLzWO"},{"type":"link","url":"https://www.nsf.gov/funding/opportunities/pesose-pathways-enable-secure-open-source-ecosystems/nsf26-506/solicitation","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"PESOSE","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"p3Z71UwzPk"}],"urlSource":"https://www.nsf.gov/fundi