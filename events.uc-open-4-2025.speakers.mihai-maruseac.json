{"version":3,"kind":"Article","sha256":"2132b75e71eb77e19f1d61ea945097657cdf4adbe183cbad50b82fe3feb8e400","slug":"events.uc-open-4-2025.speakers.mihai-maruseac","location":"/events/uc-open-4-2025/speakers/mihai-maruseac.md","dependencies":[],"frontmatter":{"title":"Mihai Maruseac","github":"https://github.com/UC-OSPO-Network/ucospo.net","copyright":"2024","numbering":{"title":{"offset":1}},"source_url":"https://github.com/UC-OSPO-Network/ucospo.net/blob/main/events/uc-open-4-2025/speakers/mihai-maruseac.md","edit_url":"https://github.com/UC-OSPO-Network/ucospo.net/edit/main/events/uc-open-4-2025/speakers/mihai-maruseac.md","thumbnail":"/build/mihai-maruseac-89a92c1c864ef281256835bee331df96.jpg","exports":[{"format":"md","filename":"mihai-maruseac.md","url":"/build/mihai-maruseac-989a4d837742fd6712107d0ce953365b.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"image","url":"/build/mihai-maruseac-89a92c1c864ef281256835bee331df96.jpg","alt":"Speaker photo","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"CkJY3CSyE6","urlSource":"headshots/mihai-maruseac.jpg"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Mihai Maruseac is a member of the Google Open Source Security Team (GOSST), working on Supply Chain Security for ML. He is a co-lead on a Secure AI Framework (SAIF) workstream from Google. Under OpenSSF, Mihai chairs the AI/ML working group and the model signing project. Mihai is also a GUAC maintainer. Before joining GOSST, Mihai created the TensorFlow Security team and prior to Google, he worked on adding Differential Privacy to Machine Learning algorithms. Mihai has a PhD in Differential Privacy from UMass Boston.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"Hl1Ww8R5xN"}],"key":"diO7q4q9Ue"},{"type":"heading","depth":2,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"child